{
  "globs": ["**/*.md"],
  "config": {
    "MD013": {
        "line_length": 120,
        "code_blocks": false,
        "tables": false
    }
  },
  // CLAUDE.md is an @-include stub, not a standalone document.
  // Vendored dependencies and archived changes (historical records) are not linted.
  "ignores": ["CLAUDE.md", "**/node_modules/**", "openspec/changes/archive/**"]
}
